impl crate::Serialize for float32 {
    func serialize(self &Self, serializer Serializer) error { return serializer.Float64(float64(*self)) }
}
impl crate::Deserialize for float32 {
    func deserialize(deserializer Deserializer) (Self, error) {
        var result Self
        value, err := ReadFloat64(deserializer)
        if err != nil { return result, err }
        if value > 3.4028234663852886e38 || value < -3.4028234663852886e38 || (value != 0 && float32(value) == 0) { return result, NewError(Range, "float32 overflow or underflow") }
        result = float32(value)
        return result, nil
    }
    func missing() (Self, bool) { var zero Self; return zero, false }
}

impl crate::Serialize for float64 {
    func serialize(self &Self, serializer Serializer) error { return serializer.Float64(float64(*self)) }
