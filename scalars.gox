package serde

impl crate::Serialize for bool {
    func serialize(self &Self, serializer Serializer) error { return serializer.Bool(*self) }
}
impl crate::Deserialize for bool {
    func deserialize(deserializer Deserializer) (Self, error) {
        var result Self
        value, err := ReadBool(deserializer)
        if err != nil { return result, err }
        result = bool(value)
        return result, nil
    }
    func missing() (Self, bool) { var zero Self; return zero, false }
}

impl crate::Serialize for string {
    func serialize(self &Self, serializer Serializer) error { return serializer.String(*self) }
}
impl crate::Deserialize for string {
    func deserialize(deserializer Deserializer) (Self, error) {
        var result Self
        value, err := ReadString(deserializer)
        if err != nil { return result, err }
        result = string(value)
        return result, nil
    }
    func missing() (Self, bool) { var zero Self; return zero, false }
}

impl crate::Serialize for int {
    func serialize(self &Self, serializer Serializer) error { return serializer.Int64(int64(*self)) }
}
impl crate::Deserialize for int {
    func deserialize(deserializer Deserializer) (Self, error) {
        var result Self
        value, err := ReadInt64(deserializer)
        if err != nil { return result, err }
        result = int(value)
        if int64(result) != value { return result, NewError(Range, "int overflow") }
        return result, nil
    }
    func missing() (Self, bool) { var zero Self; return zero, false }
}

